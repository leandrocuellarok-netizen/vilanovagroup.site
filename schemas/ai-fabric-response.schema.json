{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vilanovagroup.site/schemas/ai-fabric-response.schema.json",
  "title": "VILANOVA AI FABRIC prompt response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "request_id",
    "generation_mode",
    "model_connected",
    "target_word_count",
    "response_created_at",
    "retention_mode"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "needs_clarification",
        "unavailable",
        "budget_exceeded"
      ]
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "generation_mode": {
      "type": "string",
      "enum": [
        "prototype_template",
        "model_gateway",
        "none"
      ]
    },
    "model_connected": {
      "type": "boolean"
    },
    "target_word_count": {
      "type": "integer",
      "enum": [
        3000,
        4500,
        6000
      ]
    },
    "response_created_at": {
      "type": "string",
      "format": "date-time"
    },
    "retention_mode": {
      "const": "ephemeral"
    },
    "english_prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100000
    },
    "word_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6000
    },
    "clarification_question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "error_code": {
      "type": "string",
      "enum": [
        "no_provider",
        "upstream_unavailable",
        "budget_ceiling",
        "rate_limited",
        "policy_block"
      ]
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent_preserved",
        "target_attained",
        "factuality_guardrails_included"
      ],
      "properties": {
        "intent_preserved": {
          "type": "boolean"
        },
        "target_attained": {
          "type": "boolean"
        },
        "factuality_guardrails_included": {
          "type": "boolean"
        },
        "issues": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "model_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "model_id"
      ],
      "properties": {
        "provider_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
        },
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "estimated_cost_usd",
        "actual_cost_usd",
        "budget_ceiling_usd",
        "budget_state"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "estimated_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "actual_cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "budget_ceiling_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "budget_state": {
          "type": "string",
          "enum": [
            "within_limit",
            "stopped_before_generation",
            "stopped_during_generation"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ready"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "english_prompt",
          "word_count",
          "quality"
        ],
        "not": {
          "required": [
            "clarification_question"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "needs_clarification"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "clarification_question"
        ],
        "properties": {
          "generation_mode": {
            "const": "none"
          },
          "model_connected": {
            "const": false
          }
        },
        "not": {
          "required": [
            "english_prompt"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "unavailable",
              "budget_exceeded"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "generation_mode": {
            "const": "none"
          },
          "model_connected": {
            "const": false
          }
        },
        "not": {
          "required": [
            "english_prompt"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "generation_mode": {
            "const": "prototype_template"
          }
        },
        "required": [
          "generation_mode"
        ]
      },
      "then": {
        "required": [
          "status",
          "model_connected",
          "word_count",
          "quality"
        ],
        "properties": {
          "status": {
            "const": "ready"
          },
          "model_connected": {
            "const": false
          },
          "quality": {
            "properties": {
              "target_attained": {
                "const": false
              }
            },
            "required": [
              "target_attained"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "target_word_count": {
                  "const": 3000
                }
              },
              "required": [
                "target_word_count"
              ]
            },
            "then": {
              "properties": {
                "word_count": {
                  "maximum": 2999
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "target_word_count": {
                  "const": 4500
                }
              },
              "required": [
                "target_word_count"
              ]
            },
            "then": {
              "properties": {
                "word_count": {
                  "maximum": 4499
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "target_word_count": {
                  "const": 6000
                }
              },
              "required": [
                "target_word_count"
              ]
            },
            "then": {
              "properties": {
                "word_count": {
                  "maximum": 5999
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "generation_mode": {
            "const": "model_gateway"
          }
        },
        "required": [
          "generation_mode"
        ]
      },
      "then": {
        "required": [
          "status",
          "model_connected",
          "word_count",
          "quality",
          "usage",
          "model_reference"
        ],
        "properties": {
          "status": {
            "const": "ready"
          },
          "model_connected": {
            "const": true
          },
          "quality": {
            "properties": {
              "target_attained": {
                "const": true
              }
            },
            "required": [
              "target_attained"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "target_word_count": {
                  "const": 3000
                }
              },
              "required": [
                "target_word_count"
              ]
            },
            "then": {
              "properties": {
                "word_count": {
                  "minimum": 3000
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "target_word_count": {
                  "const": 4500
                }
              },
              "required": [
                "target_word_count"
              ]
            },
            "then": {
              "properties": {
                "word_count": {
                  "minimum": 4500
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "target_word_count": {
                  "const": 6000
                }
              },
              "required": [
                "target_word_count"
              ]
            },
            "then": {
              "properties": {
                "word_count": {
                  "minimum": 6000
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "generation_mode": {
            "const": "none"
          }
        },
        "required": [
          "generation_mode"
        ]
      },
      "then": {
        "properties": {
          "model_connected": {
            "const": false
          },
          "status": {
            "enum": [
              "needs_clarification",
              "unavailable",
              "budget_exceeded"
            ]
          }
        },
        "not": {
          "required": [
            "english_prompt"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "budget_exceeded"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "error_code": {
            "const": "budget_ceiling"
          }
        }
      }
    }
  ]
}
