{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vilanovagroup.site/schemas/media-review-queue.schema.json",
  "title": "Vilanova Media Human Review Queue",
  "description": "Unreviewed GDELT news discovery candidates. This structure is deliberately not an Evidence Ledger event and cannot assert verification or confidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "queue_id", "provider_id", "query", "requested_timespan", "requested_sort", "provider_retrieved_at", "generated_at", "queue_status", "source_result_count", "candidate_count", "duplicate_count", "ledger_imported", "candidates"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "queue_id": { "type": "string", "pattern": "^mrq_[a-f0-9]{24}$" },
    "provider_id": { "const": "gdelt-doc-2" },
    "query": { "type": "string", "minLength": 1, "maxLength": 500 },
    "requested_timespan": { "enum": ["15min", "30min", "1h", "6h", "24h", "7d", "30d", "3m"] },
    "requested_sort": { "enum": ["DateDesc", "DateAsc", "HybridRel", "ToneDesc", "ToneAsc"] },
    "provider_retrieved_at": { "type": "string", "format": "date-time" },
    "generated_at": { "type": "string", "format": "date-time" },
    "queue_status": { "const": "awaiting_human_review" },
    "source_result_count": { "type": "integer", "minimum": 0 },
    "candidate_count": { "type": "integer", "minimum": 0 },
    "duplicate_count": { "type": "integer", "minimum": 0 },
    "ledger_imported": { "const": false },
    "candidates": { "type": "array", "items": { "$ref": "#/$defs/candidate" } }
  },
  "$defs": {
    "reviewStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "status"],
      "properties": { "step_id": { "type": "string" }, "status": { "const": "pending" } }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "title", "source_url", "canonical_url", "source_domain", "language", "source_country", "provider_seen_at", "publication_at", "captured_at", "evidence_class", "review_status", "review"],
      "properties": {
        "candidate_id": { "type": "string", "pattern": "^mc_[a-f0-9]{24}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "source_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "canonical_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "source_domain": { "type": "string", "minLength": 1 },
        "language": { "type": ["string", "null"] },
        "source_country": { "type": ["string", "null"] },
        "provider_seen_at": { "type": ["string", "null"], "format": "date-time" },
        "publication_at": { "const": null },
        "captured_at": { "type": "string", "format": "date-time" },
        "evidence_class": { "const": "news_discovery_candidate" },
        "review_status": { "const": "unreviewed" },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "decision", "reviewer_id", "reviewed_at", "decision_basis", "steps"],
          "properties": {
            "status": { "const": "pending" },
            "decision": { "const": null },
            "reviewer_id": { "const": null },
            "reviewed_at": { "const": null },
            "decision_basis": { "const": null },
            "steps": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "prefixItems": [
                { "$ref": "#/$defs/reviewStep", "properties": { "step_id": { "const": "publisher_identity_and_original_page" } } },
                { "$ref": "#/$defs/reviewStep", "properties": { "step_id": { "const": "publication_timestamp" } } },
                { "$ref": "#/$defs/reviewStep", "properties": { "step_id": { "const": "claim_and_article_context" } } },
                { "$ref": "#/$defs/reviewStep", "properties": { "step_id": { "const": "cross_source_duplicate_story_check" } } },
                { "$ref": "#/$defs/reviewStep", "properties": { "step_id": { "const": "copyright_and_attribution_check" } } },
                { "$ref": "#/$defs/reviewStep", "properties": { "step_id": { "const": "human_reviewer_decision" } } }
              ],
              "items": false
            }
          }
        }
      }
    }
  }
}
